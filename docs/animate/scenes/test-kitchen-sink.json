{
  "format": "harpoon-animate/1",
  "id": "kitchen-sink",
  "title": "Test: every element type",
  "root": "header",
  "canvas": {
    "width": 1000,
    "height": 420,
    "background": "#0F1E3C"
  },
  "mobile": {
    "below": 560,
    "width": 375,
    "height": 360
  },
  "trigger": {
    "on": "view",
    "threshold": 0.25,
    "replay": true
  },
  "styles": {
    "display": {
      "family": "DM Serif Display",
      "source": "google",
      "weight": 400,
      "size": 72,
      "lineHeight": 1.05,
      "color": "#FFFFFF"
    },
    "kicker": {
      "family": "DM Sans",
      "source": "google",
      "weight": 700,
      "size": 22,
      "lineHeight": 1.2,
      "color": "#F3B735",
      "letterSpacing": 0.12
    }
  },
  "elements": [
    {
      "id": "kicker",
      "type": "text",
      "tag": "p",
      "style": "kicker",
      "text": "HARPOON ANIMATE \u00b7 TEST",
      "x": 60,
      "y": 60,
      "w": 600,
      "h": 30,
      "animate": {
        "name": "fadeInDown",
        "delay": 0.2,
        "duration": 0.6,
        "distance": 0.5
      },
      "m": {
        "x": 20,
        "y": 30,
        "w": 335,
        "h": 24,
        "size": 13
      }
    },
    {
      "id": "title",
      "type": "text",
      "tag": "h1",
      "style": "display",
      "text": "A headline that\nbounces into place",
      "x": 60,
      "y": 110,
      "w": 700,
      "h": 190,
      "animate": {
        "name": "bounceIn",
        "delay": 0.4,
        "duration": 1
      },
      "m": {
        "x": 20,
        "y": 64,
        "w": 335,
        "h": 130,
        "size": 40
      }
    },
    {
      "id": "bar",
      "type": "rect",
      "x": 60,
      "y": 320,
      "w": 300,
      "h": 10,
      "fill": "#F3B735",
      "radius": 5,
      "animate": {
        "name": "wipeInLeft",
        "delay": 1.1,
        "duration": 0.7
      },
      "m": {
        "x": 20,
        "y": 215,
        "w": 160,
        "h": 8
      }
    },
    {
      "id": "dot",
      "type": "ellipse",
      "x": 760,
      "y": 90,
      "w": 180,
      "h": 180,
      "fill": "#C9495E",
      "animate": {
        "name": "pulse",
        "delay": 0,
        "duration": 1.6,
        "loop": true
      },
      "m": {
        "x": 250,
        "y": 240,
        "w": 90,
        "h": 90
      }
    },
    {
      "id": "badge",
      "type": "image",
      "src": "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Cpolygon points='50,5 61,38 95,38 67,59 78,92 50,72 22,92 33,59 5,38 39,38' fill='%23ffffff'/%3E%3C/svg%3E",
      "alt": "White star",
      "x": 800,
      "y": 300,
      "w": 100,
      "h": 100,
      "animate": {
        "name": "zoomIn",
        "delay": 1.4,
        "duration": 0.6
      },
      "m": {
        "hidden": true
      }
    },
    {
      "id": "underline",
      "type": "line",
      "x": 60,
      "y": 360,
      "w": 880,
      "h": 4,
      "stroke": "#FFFFFF",
      "strokeWidth": 1,
      "opacity": 0.4,
      "animate": {
        "name": "wipeInRight",
        "delay": 1.2,
        "duration": 0.8
      },
      "m": {
        "x": 20,
        "y": 340,
        "w": 335,
        "h": 4
      }
    }
  ]
}